# ── 의존성 · 빌드 산출물 ────────────────────────────────────────
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# ── 환경 · secret ───────────────────────────────────────────────
# P1: secret 은 저장소에 들어가지 않는다. .env.example 만 커밋한다.
.env
.env.*
!.env.example
*.pem
*.key

# ── 루프 ────────────────────────────────────────────────────────
# 설치 시점의 PATH·claude.exe 경로. 기계마다 다르다.
loop/env.local.ps1
# 있으면 루프가 멈춘다. 상태이지 설정이 아니다.
loop/STOP
# 누가 잠금을 들고 있나 (진단 전용). 배타는 OS 뮤텍스가 한다.
loop/.lock

# ── 검사 산출물 · 로그 ──────────────────────────────────────────
# .ci/shots 는 관통마다 통째로 지워진다. 근거 캡처는 밖으로 복사해라.
.ci/
logs/

# ── 로컬 도구 ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
