# =====================================================================
#  apps/web/.env.example — 필요한 환경변수의 정본 목록 (SPEC §1.2 · §2 · §7.5 · §11)
#
#  🔴 **여기에 실제 값을 적지 마라.** `.gitignore` 가 `.env*` 를 막고 이 파일만
#     통과시킨다. 값은 각자 기계의 `.env.local` 과 Vercel 환경변수에만 산다 (P1).
#
#  ★ 새 환경변수를 더하는 절차: ① 여기 한 줄(무엇에 쓰는지 같이) ② 읽는 코드
#     ③ 없으면 **켜질 때 크게 죽게** 한다 — 조용히 undefined 로 도는 것이
#     제일 늦게 발견된다 (src/db/client.ts 참고).
# =====================================================================

# ── DB (SPEC §2) ─────────────────────────────────────────────────────
#  🙋 Supabase 프로젝트 생성·키 발급은 사람이 한다 (docs/STATUS.md 「막힌 것」).
#  Supabase → Project Settings → Database → Connection string(URI).
#  ⚠ 서버리스(Vercel)에서는 **pooler(6543) + ?pgbouncer=true** 를 쓴다.
#    마이그레이션은 pooler 로 돌리지 마라 — 직결(5432)이어야 한다.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ── Supabase Auth (SPEC §1.2) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#  🔴 service role 키는 서버에서만 쓴다. NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 샌다.
SUPABASE_SERVICE_ROLE_KEY=

# ── 서버측 AI (SPEC §7 · P3) ─────────────────────────────────────────
#  🔴 P2 — 이건 **우리 API 키**다. 사용자의 Claude 구독을 대신 부르는 것이 아니다.
#  🔴 P3 — 모든 호출은 withBudget() 을 거친다. 키가 없으면 픽스처 결과로 떨어진다.
ANTHROPIC_API_KEY=
#  모델은 환경변수로 바꿀 수 있다 (SPEC §1.2). 기본값은 코드에 있다.
ANTHROPIC_MODEL=claude-sonnet-4-5
#  하루 예산 상한(USD). 넘으면 BUDGET_EXCEEDED (SPEC §7.5).
AI_DAILY_BUDGET_USD=5
