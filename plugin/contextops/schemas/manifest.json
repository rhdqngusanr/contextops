{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "team_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "project_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "context_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "snapshot_hash": {
      "$ref": "#/$defs/__schema0"
    },
    "files": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "milestones": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "excluded": {
      "default": [],
      "maxItems": 200,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "manifest_hash": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "schema_version",
    "compiler_version",
    "template_version",
    "team_id",
    "project_id",
    "context_version",
    "generated_at",
    "snapshot_hash",
    "files",
    "manifest_hash"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema2"
        },
        "sha256": {
          "$ref": "#/$defs/__schema0"
        },
        "size": {
          "$ref": "#/$defs/__schema3"
        },
        "target": {
          "$ref": "#/$defs/__schema4"
        },
        "source_item_ids": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "target",
        "source_item_ids"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "source_item_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "path": {
              "enum": [
                ".claude/rules/workflow.md"
              ]
            }
          }
        }
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!\\/)(?!.*\\.\\.)(?![a-zA-Z]:)[^\\0]+$"
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "claude",
        "agents",
        "cursor"
      ]
    },
    "__schema5": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "string",
      "pattern": "^item_[a-z0-9_]{3,40}$"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{1,4}-M\\d{1,2}$|^M\\d{1,2}$"
        },
        "due": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "paths": {
          "default": [],
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "done_when": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "id",
        "done_when"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/__schema6"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "item_id",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
